# LuxeHaven Platform Environment Configuration

NODE_ENV=development
PORT=5000

# Database & Cache Connection Strings
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/luxehaven?schema=public"
REDIS_URL="redis://localhost:6379"

# Security & JWT Tokens
JWT_SECRET="luxehaven-super-secret-jwt-signing-key-2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="luxehaven-super-secret-jwt-refresh-signing-key-2026"
JWT_REFRESH_EXPIRES_IN="7d"

# S3 & MinIO Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="luxehaven-properties"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# SMTP Mail Delivery (Mailpit for dev)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""

# Payments (Stripe & M-Pesa Integration Secrets)
STRIPE_SECRET_KEY="sk_test_mock_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_mock_stripe_webhook_secret"

# Frontend Application Binding
FRONTEND_URL="http://localhost:3000"
